{
  "name": "nexusplay-platform",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "NexusPlay - Production-Grade Full Stack Gaming & Esports Platform Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=apps/server",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "seed": "npm run seed --workspace=apps/server",
    "git:history": "node scripts/generate-pr-history.js"
  },
  "keywords": [
    "gaming",
    "esports",
    "threejs",
    "react",
    "typescript",
    "socketio",
    "nodejs",
    "game-engine",
    "monorepo",
    "fullstack"
  ],
  "author": "NexusPlay Engineering Team",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
