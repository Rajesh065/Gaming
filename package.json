{
  "name": "nexusplay-platform",
  "version": "1.0.0",
  "private": true,
  "description": "NexusPlay - Enterprise-Scale Full Stack Gaming & Esports Platform Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "seed": "npm run seed --workspace=apps/server",
    "git:history": "node scripts/generate-pr-history.js"
  },
  "keywords": [
    "gaming",
    "esports",
    "threejs",
    "react",
    "typescript",
    "socketio",
    "nodejs",
    "game-engine",
    "monorepo",
    "fullstack"
  ],
  "author": "NexusPlay Core Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
